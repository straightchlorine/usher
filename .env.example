# Local docker compose settings.
# Copy to .env and adjust. Every value has a default in docker-compose.yml,
# so the stack also runs without a .env.
#
# Defaults are dev only.

# database (postgres)
DB_HOST=database

# host port;
DB_HOST_PORT=5432
DB_NAME=event_api
DB_USER=postgres
DB_PASSWORD=password

# api host port;
API_PORT=8080
API_JWT_SECRET=replace-with-a-long-random-string
API_TOKEN_VALID_HOURS=24

# accounts created on startup
API_ROOT_NAME=root
API_ROOT_PASSWORD=root
DEMO_USERNAME=demo
DEMO_PASSWORD=matchday

# web frontend (host port)
WEB_PORT=80

# nocodb, database ui (host port and its own metadata db)
NC_DB_PORT=8081
NC_DB_NAME=nocodb_metadata
NC_DB_USER=nocodb
NC_DB_PASSWORD=password
NC_AUTH_JWT=replace-with-a-long-random-string

# swagger ui (host port)
SWAGGER_PORT=81

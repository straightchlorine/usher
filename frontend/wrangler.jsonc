{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker serving the SPA and proxying /api/* to the API.
  "name": "usher-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Workers custom domain:
  // Cloudflare creates the DNS record and certificate.
  "routes": [
    {
      "pattern": "usher.piotrkrzysztof.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // Unknown paths get index.html so client-side routes survive a reload.
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker first; everything else is served as a static asset.
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_ORIGIN": "https://usher-api.piotrkrzysztof.dev"
  },
  "ratelimits": [
    {
      // POST /api/login and POST /api/register: 10 requests per minute per IP and location.
      "name": "AUTH_LIMITER",
      "namespace_id": "4101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // Every other /api request: 120 requests per minute per IP and location.
      "name": "API_LIMITER",
      "namespace_id": "4102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
